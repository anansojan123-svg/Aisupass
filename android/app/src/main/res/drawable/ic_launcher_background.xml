<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景：青蓝→紫→粉渐变，上覆高斯白雾与白纱，蓝粉微微透出。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 底层满版渐变 -->
    <path android:pathData="M0,0h1024v1024H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="96"
                android:startY="32"
                android:endX="944"
                android:endY="1000">
                <item android:color="#FF4AD3FF" android:offset="0" />
                <item android:color="#FF7C6BFF" android:offset="0.5" />
                <item android:color="#FFFF6FB5" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上蓝光 -->
    <path android:pathData="M0,0h1024v1024H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="806"
                android:centerY="196"
                android:gradientRadius="430">
                <item android:color="#8C38D6FF" android:offset="0" />
                <item android:color="#0038D6FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左下粉光 -->
    <path android:pathData="M0,0h1024v1024H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="222"
                android:centerY="846"
                android:gradientRadius="470">
                <item android:color="#80FF7BC0" android:offset="0" />
                <item android:color="#00FF7BC0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 白雾（左上主团，多段停靠模拟高斯衰减） -->
    <path android:pathData="M0,0h1024v1024H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="392"
                android:centerY="330"
                android:gradientRadius="620">
                <item android:color="#DCFFFFFF" android:offset="0" />
                <item android:color="#A8FFFFFF" android:offset="0.38" />
                <item android:color="#5CFFFFFF" android:offset="0.66" />
                <item android:color="#1FFFFFFF" android:offset="0.86" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 白雾（右下副团） -->
    <path android:pathData="M0,0h1024v1024H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="742"
                android:centerY="742"
                android:gradientRadius="560">
                <item android:color="#B8FFFFFF" android:offset="0" />
                <item android:color="#85FFFFFF" android:offset="0.4" />
                <item android:color="#3DFFFFFF" android:offset="0.72" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 整体白纱 -->
    <path
        android:pathData="M0,0h1024v1024H0z"
        android:fillColor="#66FFFFFF" />
</vector>
